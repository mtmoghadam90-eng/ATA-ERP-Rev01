# --- Application ---
# Port the app listens on (default 3000)
# PORT=3000

# Path to the application data file (default ./database.json)
# ERP_DB_PATH=D:/ATA-ERP-Rev01/database.json

# Secret used to sign session cookies. Generated and stored automatically if
# unset; set it explicitly to keep sessions valid across a data-file reset.
# ERP_SESSION_SECRET=


# --- Operational database (SQL Server) ---
# The relational store the application itself runs on, managed by Prisma.
# Note the ; separators and that special characters in the password must be
# percent-encoded (e.g. @ -> %40).
DATABASE_URL="sqlserver://192.168.1.104:1433;database=ata_erp;user=ata_app;password=CHANGE_ME;trustServerCertificate=true;encrypt=false"


# --- Power BI reporting sync (SQL Server) ---
# One-way export of the app data into flat SQL Server tables for Power BI.
# The app itself keeps using its own store; this only writes a reporting copy.

# Server host (or host\instance). Required to enable the sync.
ERP_SQL_SERVER=192.168.1.104
ERP_SQL_PORT=1433

# Target database — create it once: CREATE DATABASE ata_erp_reporting;
ERP_SQL_DATABASE=ata_erp_reporting

# SQL authentication (recommended for a Node app)
ERP_SQL_USER=ata_report
ERP_SQL_PASSWORD=

# Use Windows authentication instead of the user/password above
# ERP_SQL_TRUSTED=true

# Schema the reporting tables live in (default: rpt)
# ERP_SQL_SCHEMA=rpt

# TLS. A LAN SQL Server 2017 usually has a self-signed certificate, so the
# certificate is trusted by default. Set ENCRYPT=true if TLS is configured.
# ERP_SQL_ENCRYPT=false
# ERP_SQL_TRUST_CERT=true
