// ATA-ERP relational schema (SQL Server 2017)
//
// Design decisions, applied consistently throughout:
//
//  1. Custom fields  -> a single `customValues` JSON column. The field set is
//     user-defined at runtime, so fixed columns are impossible and EAV would put
//     a join on every query. When one specific field needs fast filtering, add a
//     PERSISTED computed column over JSON_VALUE plus an index for that field only.
//
//  2. Dates -> stored twice: a real DATE for sorting, ranges, date maths and
//     Power BI time intelligence, plus the Shamsi string exactly as the user saw
//     it, so nothing is ever lost to a conversion round-trip.
//     Convention: `xDate` (DATE) + `xDateJalali` (NVARCHAR(10), "1405/05/06").
//
//  3. Nested arrays -> child tables when the thing is an entity that is queried,
//     aggregated or reported on (proforma items, variants, steps...). JSON when it
//     is configuration that only ever travels with its parent (product features,
//     packing checklist, settings).
//
//  4. Record ownership -> real foreign keys (ownerUserId), so record-level access
//     rules can be enforced in the database rather than guessed from a name string.
//
// Note on ids: bounded NVARCHAR(36) so they can carry primary keys and unique
// indexes (SQL Server caps index keys at 900 bytes).

generator client {
  provider = "prisma-client-js"
}

// Prisma 7 takes the connection URL from prisma.config.ts, not from here.
datasource db {
  provider = "sqlserver"
}

/**
 * ============================ people & access ============================
 */

model User {
  id             String  @id @default(uuid()) @db.NVarChar(36)
  username       String  @unique @db.NVarChar(100)
  passwordHash   String  @db.NVarChar(200)
  fullName       String  @db.NVarChar(200)
  role           String  @default("user") @db.NVarChar(30)
  isSystemAdmin  Boolean @default(false)
  position       String? @db.NVarChar(150)
  signatureImage String? @db.NVarChar(500)
  isActive       Boolean @default(true)

  /// Module permissions, e.g. { "customers": true, "transactions": false }
  permissions String? @db.NVarChar(Max)

  /// Bumped to invalidate every session cookie already issued to this user.
  sessionEpoch Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownedCustomers    Customer[]           @relation("CustomerOwner")
  ownedProjects     Project[]            @relation("ProjectOwner")
  createdProformas  Proforma[]           @relation("ProformaCreator")
  auditLogs         AuditLog[]
  activities        ProjectActivity[]
  assignedReferrals ProjectReferral[]    @relation("ReferralAssignee")
  raisedReferrals   ProjectReferral[]    @relation("ReferralAuthor")
  referralMessages  ReferralMessage[]
  notifications     ModuleNotification[]
  readReceipts      ReadReceipt[]

  @@index([isActive])
  @@map("users")
}

/**
 * ================================ customers ==============================
 */

model Customer {
  id           String @id @default(uuid()) @db.NVarChar(36)
  customerType String @db.NVarChar(20) // حقیقی | حقوقی
  status       String @default("فعال") @db.NVarChar(20)

  /// Legal name, or the computed full name for an individual.
  companyName String  @db.NVarChar(300)
  firstName   String? @db.NVarChar(150)
  lastName    String? @db.NVarChar(150)
  gender      String? @db.NVarChar(10)
  position    String? @db.NVarChar(150)

  economicCode String? @db.NVarChar(50)
  industry     String? @db.NVarChar(150)
  keyPerson    String? @db.NVarChar(200)

  phone    String? @db.NVarChar(50)
  mobile   String? @db.NVarChar(50)
  email    String? @db.NVarChar(200)
  province String? @db.NVarChar(100)
  city     String? @db.NVarChar(100)
  address  String? @db.NVarChar(Max)
  notes    String? @db.NVarChar(Max)
  tags     String? @db.NVarChar(500)

  /// Normalized for duplicate detection (fa digits -> ascii, +98 stripped).
  mobileNormalized String? @db.NVarChar(30)

  customValues String? @db.NVarChar(Max)

  /// The manual half of customer value: judgements a person makes, which no
  /// amount of sales data can answer. The computed half lives in
  /// `CustomerValueMetrics` — see there for why the two are kept apart.
  ///
  /// The five potential parameters are 1..5 and are all-or-nothing: until every
  /// one is answered the customer is «در انتظار ارزیابی» rather than ranked,
  /// because an unanswered form is not the same as a low score.
  potentialConsumption    Int?      @db.SmallInt
  potentialCompanySize    Int?      @db.SmallInt
  potentialProjects       Int?      @db.SmallInt
  potentialPortfolioFit   Int?      @db.SmallInt
  potentialRepeatPurchase Int?      @db.SmallInt
  /// 0..100, derived from the five above and the weights in settings. Stored
  /// beside its own inputs because it depends on nothing else.
  potentialValueScore     Float?
  potentialAssessedAt     DateTime?
  potentialAssessedBy     String?   @db.NVarChar(36)

  /// `reviewed` marks the difference between a value somebody chose and the
  /// default a migration wrote. Without it a screen cannot honestly say whether
  /// «معمولی» is a judgement or a placeholder.
  paymentBehaviour    String? @db.NVarChar(40)
  paymentReviewed     Boolean @default(false)
  costToServe         String? @db.NVarChar(40)
  costToServeReviewed Boolean @default(false)

  /// A rank set by hand, overriding the computed one.
  ///
  /// `manualRankLocked` is the difference between the two things a person can
  /// mean by overriding a rank. Locked: this customer is an A whatever the
  /// figures say, and no recalculation may move them — for the strategic
  /// account whose worth is not in this year's numbers. Unlocked: correct it
  /// for now, and let the evaluation take back over at the next
  /// recalculation, which clears it.
  manualRank       String?   @db.NVarChar(10)
  manualRankLocked Boolean   @default(false)
  manualRankNote   String?   @db.NVarChar(400)
  manualRankSetAt  DateTime?
  manualRankSetBy  String?   @db.NVarChar(36)

  ownerUserId String? @db.NVarChar(36)
  owner       User?   @relation("CustomerOwner", fields: [ownerUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  linksFrom        CustomerLink[]             @relation("LinkFrom")
  linksTo          CustomerLink[]             @relation("LinkTo")
  projects         Project[]                  @relation("ProjectCustomer")
  endUserOf        Project[]                  @relation("ProjectEndUser")
  financialFor     Project[]                  @relation("ProjectFinancialContact")
  technicalFor     Project[]                  @relation("ProjectTechnicalContact")
  proformas        Proforma[]                 @relation("ProformaCustomer")
  contactFor       Proforma[]                 @relation("ProformaContact")
  transactions     Transaction[]
  agreements       CustomerAgreement[]
  valueMetrics     CustomerValueMetrics?
  potentialHistory CustomerPotentialHistory[]
  /// Asked us not to send them messages. Checked before every send, manual or
  /// automated: a company that keeps texting somebody who opted out through a
  /// different door has not honoured the opt-out at all.
  doNotContact     Boolean                    @default(false)
  /// Their chat id on Bale, if they have given us one.
  baleChatId       String?                    @db.NVarChar(60)

  messages Message[]

  // NOTE: economicCode must be unique only among customers that actually have
  // one. A plain UNIQUE constraint cannot express that in SQL Server, which
  // permits just a single NULL — it would block every customer after the first
  // that has no economic code. A filtered unique index is added instead, in
  // prisma/sql/extra-indexes.sql.
  @@index([economicCode])
  @@index([companyName])
  @@index([mobileNormalized])
  @@index([customerType, status])
  @@index([ownerUserId])
  @@map("customers")
}

/// The computed half of customer value, one row per customer.
///
/// Kept out of `customers` for two reasons. It is a different kind of data —
/// every column here is derived and rewritten wholesale by a recalculation,
/// while `customers` holds what people typed. And it is *globally* derived:
/// gross profit and frequency are scored by percentile against every other
/// active customer, so one customer's sale moves everyone else's numbers, and a
/// recalculation rewrites the whole table. Keeping that churn off the customer
/// row keeps the customer's own history readable.
///
/// Everything is persisted rather than computed per read: the grid sorts,
/// filters and pages on these columns, and the dashboard plots every customer
/// at once. Recomputing per row would make both unusable well before a thousand
/// customers.
model CustomerValueMetrics {
  customerId String   @id @db.NVarChar(36)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /// Raw figures, kept so a score can always be explained rather than trusted.
  salesRevenueRial    Decimal @default(0) @db.Decimal(19, 2)
  grossProfitRial     Decimal @default(0) @db.Decimal(19, 2)
  grossMarginPercent  Float?
  /// Share of the period's revenue whose cost is actually known. Gross profit
  /// is computed only over lines with a cost, so this says how much of the
  /// picture the figure above really covers.
  costCoveragePercent Float   @default(0)

  purchaseFrequency Int @default(0)

  lastPurchaseDate       DateTime? @db.Date
  lastPurchaseDateJalali String?   @db.NVarChar(10)
  daysSinceLastPurchase  Int?

  /// The five component scores, 0..100, each kept so the card can show its work.
  grossProfitScore Float @default(0)
  frequencyScore   Float @default(0)
  recencyScore     Float @default(0)
  paymentScore     Float @default(0)
  costToServeScore Float @default(0)

  realizedValueScore  Float   @default(0)
  potentialValueScore Float?
  customerValueIndex  Float?
  /// The rank in effect: the manual one where a person set it, else the
  /// computed one. The grid filters and sorts on this, so it has to be the
  /// single answer to "what rank is this customer".
  customerValueRank   String  @default("PENDING") @db.NVarChar(10)
  /// What the formula said, kept even when a manual rank overrides it — the
  /// card shows both, so an override never hides what it overrode.
  computedRank        String  @default("PENDING") @db.NVarChar(10)
  /// True while `customerValueRank` came from a person rather than the rules.
  rankIsManual        Boolean @default(false)

  calculatedAt DateTime @default(now())

  @@index([customerValueRank])
  @@index([customerValueIndex])
  @@index([realizedValueScore])
  @@index([potentialValueScore])
  @@index([grossProfitRial])
  @@index([lastPurchaseDate])
  @@map("customer_value_metrics")
}

/// Every change to a customer's potential assessment.
///
/// Append-only. The point is to be able to see how the company's *opinion* of a
/// customer moved over time, which is lost the moment the current answers are
/// overwritten in place.
model CustomerPotentialHistory {
  id         String   @id @default(uuid()) @db.NVarChar(36)
  customerId String   @db.NVarChar(36)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  previousScore  Float?
  newScore       Float?
  /// The five answers before and after, as JSON — a fixed set of columns would
  /// have to change every time a parameter is added.
  previousParams String? @db.NVarChar(Max)
  newParams      String? @db.NVarChar(Max)

  changedBy     String?  @db.NVarChar(36)
  changedByName String?  @db.NVarChar(200)
  changedAt     DateTime @default(now())

  @@index([customerId, changedAt])
  @@map("customer_potential_history")
}

/// Individual <-> company relationships (replaces the linkedCustomerIds array).
model CustomerLink {
  fromId String   @db.NVarChar(36)
  toId   String   @db.NVarChar(36)
  from   Customer @relation("LinkFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to     Customer @relation("LinkTo", fields: [toId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([fromId, toId])
  @@index([toId])
  @@map("customer_links")
}

model CustomerAgreement {
  id         String   @id @default(uuid()) @db.NVarChar(36)
  customerId String   @db.NVarChar(36)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  moduleName String   @db.NVarChar(100)
  text       String   @db.NVarChar(Max)
  createdBy  String?  @db.NVarChar(200)
  createdAt  DateTime @default(now())

  @@index([customerId, moduleName])
  @@map("customer_agreements")
}

/**
 * ================================ suppliers ==============================
 */

model Supplier {
  id           String  @id @default(uuid()) @db.NVarChar(36)
  name         String  @db.NVarChar(300)
  country      String? @db.NVarChar(100)
  /// The city. Most suppliers here are domestic, where «ایران» says nothing and
  /// the city is what decides whether a part is collected or freighted.
  city         String? @db.NVarChar(120)
  contactName  String? @db.NVarChar(200)
  phone        String? @db.NVarChar(50)
  email        String? @db.NVarChar(200)
  website      String? @db.NVarChar(300)
  paymentTerms String? @db.NVarChar(300)
  status       String  @default("فعال") @db.NVarChar(20)
  description  String? @db.NVarChar(Max)

  /// String[] of product categories this supplier can provide.
  providedCategories String? @db.NVarChar(Max)
  customValues       String? @db.NVarChar(Max)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrders PurchaseOrder[]
  inquiries      SupplierInquiry[]
  transactions   Transaction[]

  @@index([name])
  @@index([status])
  @@map("suppliers")
}

/**
 * ============================ products & stock ===========================
 */

model Product {
  id          String  @id @default(uuid()) @db.NVarChar(36)
  code        String  @unique @db.NVarChar(60)
  name        String  @db.NVarChar(300)
  displayName String  @db.NVarChar(300)
  category    String? @db.NVarChar(150)
  brand       String? @db.NVarChar(150)
  modelNumber String? @db.NVarChar(150)
  unit        String? @db.NVarChar(50)
  description String? @db.NVarChar(Max)
  supplyType  String  @default("INVENTORY") @db.NVarChar(20)

  hasVariants   Boolean @default(false)
  stockLevel    Decimal @default(0) @db.Decimal(18, 3)
  minStockLevel Decimal @default(0) @db.Decimal(18, 3)

  basePriceRial   Decimal? @db.Decimal(19, 2)
  priceForeign    Decimal? @db.Decimal(19, 4)
  currencyForeign String?  @db.NVarChar(20)

  /// What this item last actually cost to land, from a received purchase order.
  ///
  /// A *record of fact*, kept apart from `priceCalc` — which is the standard
  /// cost the company quotes from, and a judgement. They are deliberately not
  /// the same number: a line's share of an order's landed cost carries the
  /// freight and customs of **that shipment**, so five units flown in urgently
  /// cost several times what two hundred by sea do. Writing that straight into
  /// the standard would price every future quotation off one unusual delivery.
  ///
  /// So this is shown *beside* the calculator, with the quantity it came from,
  /// and adopting it into the standard is a button somebody presses.
  lastPurchaseCostRial    Decimal?  @db.Decimal(19, 2)
  /// How many units that purchase was for — the context that says whether the
  /// figure above is representative.
  lastPurchaseQuantity    Decimal?  @db.Decimal(18, 3)
  lastPurchaseDate        DateTime? @db.Date
  lastPurchaseDateJalali  String?   @db.NVarChar(10)
  /// Which order it came from. A plain column: the order may later be deleted,
  /// and the figure it produced is still the last thing we actually paid.
  lastPurchaseOrderId     String?   @db.NVarChar(36)
  lastPurchaseOrderNumber String?   @db.NVarChar(60)

  /// Configuration that only travels with this product: features, option lists,
  /// configRules, image paths and the price-calculator inputs.
  features     String? @db.NVarChar(Max)
  configRules  String? @db.NVarChar(Max)
  images       String? @db.NVarChar(Max)
  priceCalc    String? @db.NVarChar(Max)
  customValues String? @db.NVarChar(Max)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants              ProductVariant[]
  inventoryTransactions InventoryTransaction[]
  proformaItems         ProformaItem[]
  purchaseOrderItems    PurchaseOrderItem[]
  inquiryItems          SupplierInquiryItem[]
  projectItems          ProjectItem[]

  @@index([category])
  @@index([brand])
  @@index([displayName])
  @@map("products")
}

/// A concrete SKU. A real entity: it carries its own stock and prices.
model ProductVariant {
  id        String  @id @default(uuid()) @db.NVarChar(36)
  productId String  @db.NVarChar(36)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  sku        String  @db.NVarChar(120)
  /// featureName -> optionValue for this combination.
  attributes String? @db.NVarChar(Max)

  stockLevel      Decimal  @default(0) @db.Decimal(18, 3)
  minStockLevel   Decimal  @default(0) @db.Decimal(18, 3)
  priceRial       Decimal? @db.Decimal(19, 2)
  priceForeign    Decimal? @db.Decimal(19, 4)
  currencyForeign String?  @db.NVarChar(20)
  priceCalc       String?  @db.NVarChar(Max)

  /// What this item last actually cost to land, from a received purchase order.
  ///
  /// A *record of fact*, kept apart from `priceCalc` — which is the standard
  /// cost the company quotes from, and a judgement. They are deliberately not
  /// the same number: a line's share of an order's landed cost carries the
  /// freight and customs of **that shipment**, so five units flown in urgently
  /// cost several times what two hundred by sea do. Writing that straight into
  /// the standard would price every future quotation off one unusual delivery.
  ///
  /// So this is shown *beside* the calculator, with the quantity it came from,
  /// and adopting it into the standard is a button somebody presses.
  lastPurchaseCostRial    Decimal?  @db.Decimal(19, 2)
  /// How many units that purchase was for — the context that says whether the
  /// figure above is representative.
  lastPurchaseQuantity    Decimal?  @db.Decimal(18, 3)
  lastPurchaseDate        DateTime? @db.Date
  lastPurchaseDateJalali  String?   @db.NVarChar(10)
  /// Which order it came from. A plain column: the order may later be deleted,
  /// and the figure it produced is still the last thing we actually paid.
  lastPurchaseOrderId     String?   @db.NVarChar(36)
  lastPurchaseOrderNumber String?   @db.NVarChar(60)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventoryTransactions InventoryTransaction[]
  proformaItems         ProformaItem[]
  purchaseOrderItems    PurchaseOrderItem[]
  inquiryItems          SupplierInquiryItem[]

  @@unique([sku], map: "UQ_product_variants_sku")
  @@index([productId])
  @@map("product_variants")
}

model InventoryTransaction {
  id        String          @id @default(uuid()) @db.NVarChar(36)
  productId String          @db.NVarChar(36)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?         @db.NVarChar(36)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  occurredAt       DateTime @db.Date
  occurredAtJalali String?  @db.NVarChar(10)

  type           String  @db.NVarChar(5) // IN | OUT
  quantity       Decimal @db.Decimal(18, 3)
  /// quantity signed by direction, so SUM() gives net stock movement directly.
  signedQuantity Decimal @db.Decimal(18, 3)

  referenceType String? @db.NVarChar(30)
  referenceId   String? @db.NVarChar(36)
  notes         String? @db.NVarChar(Max)

  /// Whether this movement also changed `stockLevel` (what may be promised), or
  /// only the physical record. False for a foreign order's receipt and a packing
  /// list's issue — goods that were sold before they were bought. Persisted
  /// because correcting a row by hand has to put back exactly what it took.
  affectsAvailable Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([productId, occurredAt])
  @@index([variantId])
  @@index([referenceType, referenceId])
  @@map("inventory_transactions")
}

/**
 * ================================ projects ===============================
 */

model Project {
  id   String @id @default(uuid()) @db.NVarChar(36)
  code String @unique @db.NVarChar(60)
  name String @db.NVarChar(400)

  customerId String   @db.NVarChar(36)
  customer   Customer @relation("ProjectCustomer", fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  status      String  @db.NVarChar(50)
  lossReason  String? @db.NVarChar(300)
  description String? @db.NVarChar(Max)

  creationDate             DateTime  @db.Date
  creationDateJalali       String?   @db.NVarChar(10)
  opportunityDate          DateTime? @db.Date
  opportunityDateJalali    String?   @db.NVarChar(10)
  expectedCloseDate        DateTime? @db.Date
  expectedCloseDateJalali  String?   @db.NVarChar(10)
  winningDate              DateTime? @db.Date
  winningDateJalali        String?   @db.NVarChar(10)
  agreedDeliveryDate       DateTime? @db.Date
  agreedDeliveryDateJalali String?   @db.NVarChar(10)
  closingDate              DateTime? @db.Date
  closingDateJalali        String?   @db.NVarChar(10)

  estimatedValueRial Decimal? @db.Decimal(19, 2)
  probabilityPercent Int?

  marketingChannel      String? @db.NVarChar(150)
  leadQuality           String? @db.NVarChar(100)
  referrerName          String? @db.NVarChar(200)
  communicationMethod   String? @db.NVarChar(100)
  customerInquiryNumber String? @db.NVarChar(100)

  /// String fields for simple text values (not FK references)
  salesExpert      String? @db.NVarChar(200)
  financialContact String? @db.NVarChar(200)
  technicalContact String? @db.NVarChar(200)
  endUser          String? @db.NVarChar(200)

  /// Real references, so "only my projects" can be enforced in the database.
  ownerUserId              String?   @db.NVarChar(36)
  owner                    User?     @relation("ProjectOwner", fields: [ownerUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  endUserCustomerId        String?   @db.NVarChar(36)
  endUserCustomer          Customer? @relation("ProjectEndUser", fields: [endUserCustomerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  financialContactId       String?   @db.NVarChar(36)
  financialContactCustomer Customer? @relation("ProjectFinancialContact", fields: [financialContactId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  technicalContactId       String?   @db.NVarChar(36)
  technicalContactCustomer Customer? @relation("ProjectTechnicalContact", fields: [technicalContactId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  /// Uploaded document metadata (paths only, never file bytes).
  attachments     String? @db.NVarChar(Max)
  manualDocuments String? @db.NVarChar(Max)
  milestoneRules  String? @db.NVarChar(Max)
  customValues    String? @db.NVarChar(Max)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items              ProjectItem[]
  milestones         ProjectMilestone[]
  proformas          Proforma[]
  purchaseOrders     PurchaseOrder[]
  transactions       Transaction[]
  inquiries          SupplierInquiry[]
  deliveries         PackagingDelivery[]
  services           AfterSalesService[]
  categoryGroups     ProjectCategoryGroup[]
  /// Who to write to about this job, and how.
  ///
  /// The contact is one of the customer's linked individuals; the channel is
  /// what they prefer. Both optional — a project that says nothing falls back
  /// to the customer's own details, which is what most jobs want.
  messagingContactId String?                @db.NVarChar(36)
  messagingChannel   String?                @db.NVarChar(20)
  /// Automation leaves this job alone. Manual sends still go out — the point is
  /// to exempt one project from company-wide rules, not to silence it.
  suppressAutoMessages Boolean              @default(false)

  messages Message[]

  @@index([customerId])
  @@index([status])
  @@index([ownerUserId])
  @@index([creationDate])
  @@map("projects")
}

model ProjectItem {
  id        String  @id @default(uuid()) @db.NVarChar(36)
  projectId String  @db.NVarChar(36)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lineNo    Int

  /// Null when the row describes a generic requirement rather than a stock item.
  productId String?  @db.NVarChar(36)
  product   Product? @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  /// The specific SKU chosen for this line, when the product has variants. Kept
  /// as a plain column rather than a FK: the client also uses the sentinel
  /// 'generic' to mean "this product, no particular variant".
  variantId String? @db.NVarChar(36)

  name          String  @db.NVarChar(400)
  quantity      Decimal @default(1) @db.Decimal(18, 3)
  supplyMethod  String? @db.NVarChar(20)
  category      String? @db.NVarChar(30)
  equipmentType String? @db.NVarChar(200)
  size          String? @db.NVarChar(100)
  tagNumber     String? @db.NVarChar(100)

  @@index([projectId])
  @@index([productId])
  @@index([tagNumber])
  @@map("project_items")
}

model ProjectMilestone {
  id        String  @id @default(uuid()) @db.NVarChar(36)
  projectId String  @db.NVarChar(36)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  lineNo    Int

  name              String    @db.NVarChar(300)
  isCompleted       Boolean   @default(false)
  completedAt       DateTime? @db.Date
  completedAtJalali String?   @db.NVarChar(10)
  dueDate           DateTime? @db.Date
  dueDateJalali     String?   @db.NVarChar(10)
  notes             String?   @db.NVarChar(Max)

  triggerType         String? @db.NVarChar(30)
  triggerCategoryName String? @db.NVarChar(200)

  @@index([projectId])
  @@map("project_milestones")
}

/**
 * ================================ proformas ==============================
 */

model Proforma {
  id             String @id @default(uuid()) @db.NVarChar(36)
  proformaNumber String @unique @db.NVarChar(60)
  proformaType   String @default("FINANCIAL") @db.NVarChar(20)

  customerId String   @db.NVarChar(36)
  customer   Customer @relation("ProformaCustomer", fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  contactCustomerId String?   @db.NVarChar(36)
  contact           Customer? @relation("ProformaContact", fields: [contactCustomerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contactPrefix     String?   @db.NVarChar(100)

  projectId String?  @db.NVarChar(36)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  status      String  @db.NVarChar(50)
  isCancelled Boolean @default(false)
  lossReason  String? @db.NVarChar(300)
  currency    String  @default("ریال") @db.NVarChar(20)

  issueDate          DateTime  @db.Date
  issueDateJalali    String?   @db.NVarChar(10)
  expiryDate         DateTime? @db.Date
  expiryDateJalali   String?   @db.NVarChar(10)
  deliveryDate       DateTime? @db.Date
  deliveryDateJalali String?   @db.NVarChar(10)
  /// The day the document was sent to the customer: stamped when the status
  /// becomes «ارسال شده», so a follow-up can be scheduled from it. Nothing else
  /// records *when* a quotation went out — the issue date is when it was
  /// written, which is not the same thing.
  sentDate           DateTime? @db.Date
  sentDateJalali     String?   @db.NVarChar(10)

  totalAmount            Decimal  @default(0) @db.Decimal(19, 2)
  discountPercent        Decimal  @default(0) @db.Decimal(9, 4)
  discountAmount         Decimal  @default(0) @db.Decimal(19, 2)
  taxPercent             Decimal  @default(0) @db.Decimal(9, 4)
  taxAmount              Decimal  @default(0) @db.Decimal(19, 2)
  extraCosts             Decimal  @default(0) @db.Decimal(19, 2)
  finalAmount            Decimal  @default(0) @db.Decimal(19, 2)
  historicalExchangeRate Decimal? @db.Decimal(19, 4)

  notes          String? @db.NVarChar(Max)
  sentMethod     String? @db.NVarChar(100)
  sentRecipients String? @db.NVarChar(Max)
  customValues   String? @db.NVarChar(Max)

  creatorUserId String? @db.NVarChar(36)
  creator       User?   @relation("ProformaCreator", fields: [creatorUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  /// Sales follow-up, which is **not** the commercial outcome.
  ///
  /// OPEN | DEFERRED | NO_RESPONSE, and deliberately nothing else: won, lost,
  /// cancelled and superseded are already derived from the line statuses and
  /// `isCancelled` (see src/server/proformaStatus.ts), and a second column
  /// spelling them again is two sources of truth for one fact. This column
  /// answers only "is anybody still chasing this quotation, and if not why".
  followUpState        String    @default("OPEN") @db.NVarChar(20)
  /// Set with DEFERRED: the day the customer asked to be approached again.
  deferredUntil        DateTime? @db.Date
  deferredUntilJalali  String?   @db.NVarChar(10)

  /// The proforma this one revises, when it is explicitly a revision.
  ///
  /// A project may legitimately carry several open quotations at once — the
  /// temperature instruments, the pressure instruments, the flow meters — so a
  /// revision can never be inferred from sharing a project. It is a relation a
  /// person creates, or it does not exist. NoAction: a revision must not
  /// silently delete the document it revises, and cascade paths here are
  /// already at SQL Server's limit.
  previousVersionId String?    @db.NVarChar(36)
  previousVersion   Proforma?  @relation("ProformaVersion", fields: [previousVersionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  nextVersions      Proforma[] @relation("ProformaVersion")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items          ProformaItem[]
  purchaseOrders PurchaseOrder[]
  transactions   Transaction[]
  deliveries     PackagingDelivery[]

  @@index([customerId])
  @@index([projectId])
  @@index([status])
  /// The follow-up queue asks for the quotations still being chased.
  @@index([followUpState])
  /// "Which revision superseded this one" — read on every proforma card.
  @@index([previousVersionId])
  @@index([issueDate])
  @@map("proformas")
}

model ProformaItem {
  id         String   @id @default(uuid()) @db.NVarChar(36)
  proformaId String   @db.NVarChar(36)
  proforma   Proforma @relation(fields: [proformaId], references: [id], onDelete: Cascade)
  lineNo     Int

  productId String?         @db.NVarChar(36)
  product   Product?        @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  variantId String?         @db.NVarChar(36)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  productName String  @db.NVarChar(400)
  productCode String? @db.NVarChar(60)
  brand       String? @db.NVarChar(150)
  tagNumber   String? @db.NVarChar(100)

  quantity       Decimal @default(1) @db.Decimal(18, 3)
  /// عدد | دستگاه | متر | … — from settings.dropdownItems.units, per line.
  unit           String? @db.NVarChar(30)
  unitPriceRial  Decimal @default(0) @db.Decimal(19, 2)
  totalPriceRial Decimal @default(0) @db.Decimal(19, 2)

  /// What this line cost us, per unit — the home of record for cost of goods.
  ///
  /// Snapshotted onto the sale rather than read back from the product, because
  /// a product's cost changes: pricing it again next year would otherwise
  /// rewrite last year's profit and every customer's rank. It is also the only
  /// possible home for a free-text line, which has no product at all.
  ///
  /// **In the proforma's own currency**, exactly like `unitPriceRial` above —
  /// whose name is a historical accident, it too holds the document's currency.
  /// Keeping cost and price in the same currency makes the margin *percentage*
  /// independent of the exchange rate, and computable even when the document
  /// has no stored rate; only the absolute rial figure needs one.
  ///
  /// Null means nobody has said yet. Zero with `costSource = NONE` means
  /// somebody said there is no cost — a service line, or goods the customer
  /// supplies. The two are deliberately different.
  unitCost     Decimal? @db.Decimal(19, 4)
  /// The currency `unitCost` is in, recorded so changing the document's
  /// currency later is detectable rather than silently mislabelling the figure.
  costCurrency String?  @db.NVarChar(20)
  /// PURCHASE_ORDER | PRICE_CALCULATOR | MANUAL | NONE | BACKFILL — how the
  /// figure was arrived at, so "100% costed" can be told apart from "100%
  /// guessed".
  costSource   String?  @db.NVarChar(20)

  supplyMethod String? @db.NVarChar(20)
  /// Per-line outcome: جاری | برنده | بازنده | لغو شده
  status       String? @db.NVarChar(30)
  lossReason   String? @db.NVarChar(300)
  techSpecs    String? @db.NVarChar(Max)

  deliveryRange   String? @db.NVarChar(50)
  deliveryUnit    String? @db.NVarChar(20)
  deliveryType    String? @db.NVarChar(20)
  deliveryPostfix String? @db.NVarChar(100)

  selectedFeatures String? @db.NVarChar(Max)
  selectedImage    String? @db.NVarChar(500)

  @@index([proformaId])
  @@index([productId])
  @@index([status])
  @@index([tagNumber])
  @@map("proforma_items")
}

/**
 * ============================= purchase orders ===========================
 */

model PurchaseOrder {
  id       String @id @default(uuid()) @db.NVarChar(36)
  poNumber String @unique @db.NVarChar(60)

  supplierId String   @db.NVarChar(36)
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  projectId String?  @db.NVarChar(36)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  proformaId String?   @db.NVarChar(36)
  proforma   Proforma? @relation(fields: [proformaId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  status       String  @db.NVarChar(60)
  currency     String  @default("دلار") @db.NVarChar(20)
  exchangeRate Decimal @default(1) @db.Decimal(19, 4)

  orderDate                  DateTime  @db.Date
  orderDateJalali            String?   @db.NVarChar(10)
  expectedDeliveryDate       DateTime? @db.Date
  expectedDeliveryDateJalali String?   @db.NVarChar(10)
  paymentDate                DateTime? @db.Date
  paymentDateJalali          String?   @db.NVarChar(10)
  goodsReadyDate             DateTime? @db.Date
  goodsReadyDateJalali       String?   @db.NVarChar(10)
  shipmentDate               DateTime? @db.Date
  shipmentDateJalali         String?   @db.NVarChar(10)
  clearanceDate              DateTime? @db.Date
  clearanceDateJalali        String?   @db.NVarChar(10)
  receivedDate               DateTime? @db.Date
  receivedDateJalali         String?   @db.NVarChar(10)

  totalForeignAmount   Decimal @default(0) @db.Decimal(19, 4)
  shippingCostRial     Decimal @default(0) @db.Decimal(19, 2)
  customsDutyRial      Decimal @default(0) @db.Decimal(19, 2)
  remittanceFeeRial    Decimal @default(0) @db.Decimal(19, 2)
  shippingCostForeign  Decimal @default(0) @db.Decimal(19, 4)
  remittanceFeeForeign Decimal @default(0) @db.Decimal(19, 4)
  landedCostRial       Decimal @default(0) @db.Decimal(19, 2)
  landedCostForeign    Decimal @default(0) @db.Decimal(19, 4)

  notes        String? @db.NVarChar(Max)
  customValues String? @db.NVarChar(Max)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items        PurchaseOrderItem[]
  transactions Transaction[]

  @@index([supplierId])
  @@index([projectId])
  @@index([status])
  @@index([orderDate])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(uuid()) @db.NVarChar(36)
  purchaseOrderId String        @db.NVarChar(36)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  lineNo          Int

  productId String?         @db.NVarChar(36)
  product   Product?        @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  variantId String?         @db.NVarChar(36)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  productName String  @db.NVarChar(400)
  productCode String? @db.NVarChar(60)
  brand       String? @db.NVarChar(150)
  tagNumber   String? @db.NVarChar(100)

  quantity          Decimal @default(1) @db.Decimal(18, 3)
  unitPriceForeign  Decimal @default(0) @db.Decimal(19, 4)
  totalPriceForeign Decimal @default(0) @db.Decimal(19, 4)

  /// What one unit of this line actually cost, landed.
  ///
  /// `unitPriceForeign` is only what the supplier charged. Freight, customs and
  /// the remittance fee are recorded once for the whole order, so a line's real
  /// cost is its share of the order's landed total, apportioned by value. That
  /// share used to be recomputed every time anything wanted it and stored
  /// nowhere; it is written here on every save instead, so a sale can copy a
  /// figure that will not move under it.
  landedUnitCostForeign Decimal? @db.Decimal(19, 4)
  landedUnitCostRial    Decimal? @db.Decimal(19, 2)

  proformaItemId   String? @db.NVarChar(36)
  proformaItemName String? @db.NVarChar(400)
  supplierNotes    String? @db.NVarChar(Max)

  @@index([purchaseOrderId])
  @@index([productId])
  @@map("purchase_order_items")
}

/**
 * =============================== transactions ============================
 */

model Transaction {
  id             String @id @default(uuid()) @db.NVarChar(36)
  documentNumber String @unique @db.NVarChar(60)

  type        String  @db.NVarChar(20) // دریافت | پرداخت
  receiptType String? @db.NVarChar(100)
  status      String  @default("تأیید شده") @db.NVarChar(30)

  occurredAt       DateTime @db.Date
  occurredAtJalali String?  @db.NVarChar(10)

  customerId      String?        @db.NVarChar(36)
  customer        Customer?      @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supplierId      String?        @db.NVarChar(36)
  supplier        Supplier?      @relation(fields: [supplierId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  projectId       String?        @db.NVarChar(36)
  project         Project?       @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  proformaId      String?        @db.NVarChar(36)
  proforma        Proforma?      @relation(fields: [proformaId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  purchaseOrderId String?        @db.NVarChar(36)
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  /// Free-text counterparty, used when no customer/supplier record applies.
  partyName String? @db.NVarChar(300)

  amountRial      Decimal  @default(0) @db.Decimal(19, 2)
  amountForeign   Decimal? @db.Decimal(19, 4)
  exchangeRate    Decimal? @db.Decimal(19, 4)
  isDirectForeign Boolean  @default(false)

  paymentType     String  @db.NVarChar(50)
  referenceNumber String? @db.NVarChar(100)
  notes           String? @db.NVarChar(Max)

  reversalOfTransactionId String? @db.NVarChar(36)
  customValues            String? @db.NVarChar(Max)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([projectId])
  @@index([occurredAt])
  @@index([type, status])
  @@map("transactions")
}

/**
 * =========================== supplier inquiries ==========================
 */

model SupplierInquiry {
  id String @id @default(uuid()) @db.NVarChar(36)

  // Optional: a warehouse/general purchase inquiry has no job to attach to.
  projectId String?  @db.NVarChar(36)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  supplierId String   @db.NVarChar(36)
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  isWinner         Boolean   @default(false)
  winnerDate       DateTime? @db.Date
  winnerDateJalali String?   @db.NVarChar(10)

  offerConfirmed           Boolean   @default(false)
  offerConfirmedDate       DateTime? @db.Date
  offerConfirmedDateJalali String?   @db.NVarChar(10)

  creationDate       DateTime @db.Date
  creationDateJalali String?  @db.NVarChar(10)

  technicalOfferUrl String? @db.NVarChar(500)
  financialOfferUrl String? @db.NVarChar(500)

  /// A discount on the whole offer: a percentage, then a fixed amount off what
  /// is left.
  ///
  /// The amount is in the offer's own currency. That is well defined because a
  /// supplier prices a whole inquiry in one currency; for a Rial-only offer it
  /// is Rial. The Rial and foreign totals are reduced by the same proportion,
  /// so they cannot drift apart when the rate moves.
  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  discountAmount  Decimal @default(0) @db.Decimal(19, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items SupplierInquiryItem[]
  steps SupplierInquiryStep[]

  @@index([projectId])
  @@index([supplierId])
  @@index([isWinner])
  // Every page of the price history is ordered by the offer's own date.
  @@index([creationDate])
  @@map("supplier_inquiries")
}

model SupplierInquiryItem {
  id        String          @id @default(uuid()) @db.NVarChar(36)
  inquiryId String          @db.NVarChar(36)
  inquiry   SupplierInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  lineNo    Int

  /// The catalogue item this line is asking about, when it is one.
  ///
  /// Optional because an inquiry is often the first time a part is mentioned —
  /// it is priced before anyone decides to carry it. A line that does name a
  /// product carries its SKU too, so an offer for a specific configuration is
  /// unambiguous when it becomes a purchase order.
  productId String?         @db.NVarChar(36)
  product   Product?        @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  variantId String?         @db.NVarChar(36)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  name         String  @db.NVarChar(400)
  brand        String? @db.NVarChar(150)
  partNumber   String? @db.NVarChar(150)
  tagNumber    String? @db.NVarChar(100)
  quantity     Decimal @default(1) @db.Decimal(18, 3)
  currency     String  @default("دلار") @db.NVarChar(20)
  priceForeign Decimal @default(0) @db.Decimal(19, 4)
  priceRial    Decimal @default(0) @db.Decimal(19, 2)
  deliveryTime String? @db.NVarChar(100)
  notes        String? @db.NVarChar(Max)

  @@index([inquiryId])
  @@index([productId])
  @@index([variantId])
  @@map("supplier_inquiry_items")
}

model SupplierInquiryStep {
  id        String          @id @default(uuid()) @db.NVarChar(36)
  inquiryId String          @db.NVarChar(36)
  inquiry   SupplierInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  stepNo    Int

  title            String   @db.NVarChar(300)
  occurredAt       DateTime
  occurredAtJalali String?  @db.NVarChar(10)
  method           String?  @db.NVarChar(50)
  recipientName    String?  @db.NVarChar(200)
  notes            String?  @db.NVarChar(Max)

  /// Recorded automatically by the workflow engine rather than typed by a user.
  isAuto  Boolean @default(false)
  autoKey String? @db.NVarChar(40)

  @@index([inquiryId])
  @@map("supplier_inquiry_steps")
}

/**
 * ========================= packaging & after-sales =======================
 */

model PackagingDelivery {
  id                String @id @default(uuid()) @db.NVarChar(36)
  packingListNumber String @unique @db.NVarChar(60)

  projectId String  @db.NVarChar(36)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  proformaId String?   @db.NVarChar(36)
  proforma   Proforma? @relation(fields: [proformaId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  deliveryDate             DateTime  @db.Date
  deliveryDateJalali       String?   @db.NVarChar(10)
  actualDeliveryDate       DateTime? @db.Date
  actualDeliveryDateJalali String?   @db.NVarChar(10)

  shippingMethod       String? @db.NVarChar(100)
  preDeliveryTestNotes String? @db.NVarChar(Max)

  /// How the shipment can be traced: the waybill, who drove it, and the
  /// courier's tracking code. The save warns when a freight or courier
  /// shipment has none of these.
  waybillNumber String? @db.NVarChar(100)
  driverName    String? @db.NVarChar(200)
  driverPhone   String? @db.NVarChar(30)
  vehiclePlate  String? @db.NVarChar(50)
  trackingCode  String? @db.NVarChar(100)

  /// Snapshot of the checklist as ticked for this shipment, and photo paths.
  checklist String? @db.NVarChar(Max)
  photos    String? @db.NVarChar(Max)

  /// User-defined fields, keyed by the field id from `settings.customFields`.
  /// The settings screen has always offered this module; until the column
  /// existed a field could be defined for it and never filled in anywhere.
  customValues String? @db.NVarChar(Max)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items PackingItem[]

  @@index([projectId])
  @@index([deliveryDate])
  @@map("packaging_deliveries")
}

model PackingItem {
  id         String            @id @default(uuid()) @db.NVarChar(36)
  deliveryId String            @db.NVarChar(36)
  delivery   PackagingDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  lineNo     Int

  itemOrDocName String  @db.NVarChar(400)
  productId     String? @db.NVarChar(36)
  /// The exact SKU being shipped, when the product has variants. Deliberately
  /// not a relation: a packing list is a historical document and must survive
  /// the SKU being retired. The stock ledger reads it to issue the right one.
  variantId     String? @db.NVarChar(36)
  tagNumber     String? @db.NVarChar(100)
  quantity      Decimal @default(1) @db.Decimal(18, 3)
  /// عدد | دستگاه | متر | … — from settings.dropdownItems.units, per line.
  unit          String? @db.NVarChar(30)
  packageType   String? @db.NVarChar(100)
  dimensions    String? @db.NVarChar(100)
  weight        Decimal @default(0) @db.Decimal(18, 3)
  boxNumber     String? @db.NVarChar(50)

  actualDeliveryDate       DateTime? @db.Date
  actualDeliveryDateJalali String?   @db.NVarChar(10)

  @@index([deliveryId])
  @@map("packing_items")
}

model AfterSalesService {
  id String @id @default(uuid()) @db.NVarChar(36)

  projectId String  @db.NVarChar(36)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  proformaNumber   String? @db.NVarChar(60)
  proformaItemName String? @db.NVarChar(400)
  itemName         String  @db.NVarChar(400)

  status           String  @db.NVarChar(50)
  issueDescription String? @db.NVarChar(Max)
  actionsTaken     String? @db.NVarChar(Max)

  startDate        DateTime  @db.Date
  startDateJalali  String?   @db.NVarChar(10)
  endDate          DateTime? @db.Date
  endDateJalali    String?   @db.NVarChar(10)
  returnDate       DateTime? @db.Date
  returnDateJalali String?   @db.NVarChar(10)

  /// User-defined fields, keyed by the field id from `settings.customFields`.
  /// See the note on PackagingDelivery.customValues.
  customValues String? @db.NVarChar(Max)

  createdBy String?  @db.NVarChar(200)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items AfterSalesServiceItem[]

  @@index([projectId])
  @@index([status])
  @@map("after_sales_services")
}

model AfterSalesServiceItem {
  id        String            @id @default(uuid()) @db.NVarChar(36)
  serviceId String            @db.NVarChar(36)
  service   AfterSalesService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  lineNo    Int

  productId        String? @db.NVarChar(36)
  productName      String  @db.NVarChar(400)
  status           String  @db.NVarChar(50)
  issueDescription String? @db.NVarChar(Max)
  actionsTaken     String? @db.NVarChar(Max)

  startDate        DateTime? @db.Date
  startDateJalali  String?   @db.NVarChar(10)
  endDate          DateTime? @db.Date
  endDateJalali    String?   @db.NVarChar(10)
  returnDate       DateTime? @db.Date
  returnDateJalali String?   @db.NVarChar(10)

  @@index([serviceId])
  @@map("after_sales_service_items")
}

/**
 * ====================== project activity & referrals =====================
 */

model ProjectCategoryGroup {
  id        String  @id @default(uuid()) @db.NVarChar(36)
  projectId String  @db.NVarChar(36)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  categoryId   String @db.NVarChar(36)
  categoryName String @db.NVarChar(200)
  status       String @default("جاری") @db.NVarChar(30)

  startDate       DateTime? @db.Date
  startDateJalali String?   @db.NVarChar(10)
  endDate         DateTime? @db.Date
  endDateJalali   String?   @db.NVarChar(10)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities ProjectActivity[]

  @@index([projectId])
  @@index([categoryId])
  @@map("project_category_groups")
}

model ProjectActivity {
  id      String               @id @default(uuid()) @db.NVarChar(36)
  groupId String               @db.NVarChar(36)
  group   ProjectCategoryGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  text String @db.NVarChar(Max)

  authorUserId String? @db.NVarChar(36)
  author       User?   @relation(fields: [authorUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// Kept alongside the FK so history stays readable if a user is removed.
  authorName   String? @db.NVarChar(200)

  /// The first attachment, kept in its own columns so everything that already
  /// reads them — the Power BI export among them — still works.
  attachmentName String? @db.NVarChar(300)
  attachmentSize String? @db.NVarChar(50)
  attachmentUrl  String? @db.NVarChar(500)
  /// Every attachment, as `[{name, size, url}]`. The columns above are the
  /// first entry; a row written before this column existed has only them.
  attachments    String? @db.NVarChar(Max)

  /// The record whose life this entry describes — a proforma, a packing list,
  /// an inquiry. Deliberately not a foreign key: it points at six different
  /// tables, and the entry has to outlive the record when the user chooses to
  /// keep the history. Deleting that record can offer to take its entries with
  /// it, and this is what makes that exact rather than a guess at the wording.
  sourceType String? @db.NVarChar(30)
  sourceId   String? @db.NVarChar(36)

  createdAt DateTime @default(now())

  referral ProjectReferral?

  @@index([groupId])
  @@index([createdAt])
  @@index([sourceId])
  @@map("project_activities")
}

model ProjectReferral {
  id         String          @id @default(uuid()) @db.NVarChar(36)
  activityId String          @unique @db.NVarChar(36)
  activity   ProjectActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  assignedToUserId String? @db.NVarChar(36)
  assignedTo       User?   @relation("ReferralAssignee", fields: [assignedToUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignedToName   String? @db.NVarChar(200)

  assignedByUserId String? @db.NVarChar(36)
  assignedBy       User?   @relation("ReferralAuthor", fields: [assignedByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  assignedByName   String? @db.NVarChar(200)

  actionRequired String @db.NVarChar(Max)
  status         String @default("در انتظار اقدام") @db.NVarChar(40)

  createdAt DateTime @default(now())

  messages ReferralMessage[]

  @@index([assignedToUserId, status])
  @@map("project_referrals")
}

model ReferralMessage {
  id         String          @id @default(uuid()) @db.NVarChar(36)
  referralId String          @db.NVarChar(36)
  referral   ProjectReferral @relation(fields: [referralId], references: [id], onDelete: Cascade)

  text String @db.NVarChar(Max)

  responderUserId String? @db.NVarChar(36)
  responder       User?   @relation(fields: [responderUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  responderName   String? @db.NVarChar(200)

  attachmentName String? @db.NVarChar(300)
  attachmentSize String? @db.NVarChar(50)
  attachmentUrl  String? @db.NVarChar(500)

  createdAt DateTime @default(now())

  @@index([referralId])
  @@map("referral_messages")
}

/**
 * ================================== tasks ================================
 */

model Task {
  id          String  @id @default(uuid()) @db.NVarChar(36)
  title       String  @db.NVarChar(400)
  description String? @db.NVarChar(Max)

  relatedToType String? @db.NVarChar(50)
  relatedToId   String? @db.NVarChar(36)
  relatedToName String? @db.NVarChar(400)

  /// What kind of work this task is: GENERAL | SALES_FOLLOW_UP.
  ///
  /// The follow-up machinery — the queue, the duplicate check, the automatic
  /// closing when a quotation is won or lost — must act on sales follow-ups and
  /// on nothing else. Without a column saying so it would have to guess from
  /// the title or from `relatedToType`, and either guess would sweep up the
  /// ordinary tasks somebody attached to the same proforma by hand.
  taskKind String @default("GENERAL") @db.NVarChar(30)

  /// Filled in when a SALES_FOLLOW_UP task is completed through its own flow.
  /// `followUpResult` is what the customer said — a value from
  /// `settings.dropdownItems.followUpResults` — and is **not** a loss reason and
  /// not a commercial outcome.
  followUpResult   String?   @db.NVarChar(200)
  completionNote   String?   @db.NVarChar(Max)
  completedAt      DateTime? @db.Date
  completedAtJalali String?  @db.NVarChar(10)

  priority String @default("متوسط") @db.NVarChar(20)
  status   String @default("در حال انجام") @db.NVarChar(30)

  dueDate       DateTime? @db.Date
  dueDateJalali String?   @db.NVarChar(10)

  assignedToUserId String? @db.NVarChar(36)
  assignedToName   String? @db.NVarChar(200)

  reminderEnabled    Boolean   @default(false)
  reminderDate       DateTime? @db.Date
  reminderDateJalali String?   @db.NVarChar(10)
  reminderTime       String?   @db.NVarChar(5)

  customValues String? @db.NVarChar(Max)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assignedToUserId, status])
  @@index([dueDate])
  @@index([relatedToType, relatedToId])
  /// "Is there still an open follow-up on this proforma" — the duplicate check
  /// on every automatic task creation, and the queue's own join.
  @@index([taskKind, relatedToType, relatedToId, status])
  @@index([taskKind, status, dueDate])
  @@map("tasks")
}

/**
 * ========================= notes, audit, reference =======================
 */

/// Free-form notes attachable to several record types (proforma, PO, project,
/// packing list, service). One table with a discriminator rather than five.
model ModuleNote {
  id         String   @id @default(uuid()) @db.NVarChar(36)
  entityType String   @db.NVarChar(40)
  entityId   String   @db.NVarChar(36)
  text       String   @db.NVarChar(Max)
  authorName String?  @db.NVarChar(200)
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@map("module_notes")
}

/// A notice addressed to one user — "a proforma you own was approved".
///
/// Addressed by user id rather than by name, which is what the document store
/// used: two people who share a full name shared an inbox, and renaming someone
/// silently orphaned everything already sent to them.
model ModuleNotification {
  id String @id @default(uuid()) @db.NVarChar(36)

  userId String @db.NVarChar(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  module      String @db.NVarChar(100)
  title       String @db.NVarChar(300)
  description String @db.NVarChar(Max)

  /// Where it points, so the notice can open the thing it is about.
  projectId String? @db.NVarChar(36)

  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("module_notifications")
}

/// One user having seen one item in their inbox.
///
/// Per user, which the document store's flat `erp_read_items` array was not:
/// it was a single shared list, so the first person to open a referral reply
/// marked it read for everybody else too.
model ReadReceipt {
  id String @id @default(uuid()) @db.NVarChar(36)

  userId String @db.NVarChar(36)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The activity or referral-message id that was seen.
  itemId String @db.NVarChar(36)

  createdAt DateTime @default(now())

  @@unique([userId, itemId])
  @@index([userId])
  @@map("read_receipts")
}

model AuditLog {
  id     String @id @default(uuid()) @db.NVarChar(36)
  action String @db.NVarChar(20)
  module String @db.NVarChar(100)

  entityId    String? @db.NVarChar(36)
  description String  @db.NVarChar(Max)

  userId       String? @db.NVarChar(36)
  user         User?   @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userFullName String? @db.NVarChar(200)

  /// LZW-compressed JSON snapshots.
  beforeState String? @db.NVarChar(Max)
  afterState  String? @db.NVarChar(Max)

  occurredAt       DateTime @default(now())
  occurredAtJalali String?  @db.NVarChar(20)

  @@index([occurredAt])
  @@index([module, action])
  @@index([entityId])
  @@map("audit_logs")
}

model ExchangeRate {
  id          String   @id @default(uuid()) @db.NVarChar(36)
  currency    String   @unique @db.NVarChar(10)
  name        String   @db.NVarChar(50)
  rateToRial  Decimal  @db.Decimal(19, 4)
  lastUpdated DateTime @default(now())

  @@map("exchange_rates")
}

/// Application settings: a single configuration document, deliberately kept as
/// JSON because it is read whole and never queried across rows.
model AppSetting {
  id        String   @id @default("singleton") @db.NVarChar(36)
  data      String   @db.NVarChar(Max)
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

/// One firing of a time-based workflow rule, so it fires once and not once a
/// day. A sweep runs every day and the records it looks at stay due for ever
/// after their day arrives — without this, a rule that raises a follow-up task
/// would raise it again every morning. See services/workflowSchedule.ts.
model WorkflowFiring {
  id         String   @id @default(uuid()) @db.NVarChar(36)
  ruleId     String   @db.NVarChar(64)
  entityType String   @db.NVarChar(40)
  entityId   String   @db.NVarChar(36)
  /// The day the rule was due for this record, kept for the audit trail.
  dueDay     String?  @db.NVarChar(10)
  firedAt    DateTime @default(now())

  @@unique([ruleId, entityId], map: "workflow_firings_rule_entity_uq")
  @@index([entityType, entityId])
  @@map("workflow_firings")
}

/**
 * ============================== messaging ===============================
 */

/// One row per channel: how to reach the provider that sends it.
///
/// `config` holds credentials and is **never returned to a client** — the route
/// answers with a masked summary instead, the same rule `passwordHash` follows.
/// A save merges into what is stored, so leaving a secret field blank keeps the
/// existing one rather than erasing it.
model MessageProvider {
  /// SMS | BALE | EMAIL — the channel is the identity, so there is exactly one
  /// configuration per channel and no way to end up with two competing rows.
  channel String @id @db.NVarChar(20)

  active Boolean @default(false)
  /// JSON. Secrets live in here and never leave the server.
  config String? @db.NVarChar(Max)

  /// The last test send, so the settings screen can say whether it works.
  lastTestAt    DateTime?
  lastTestOk    Boolean?
  lastTestError String?   @db.NVarChar(Max)

  updatedAt DateTime @updatedAt

  @@map("message_providers")
}

/// A reusable message body with `{{placeholders}}`.
model MessageTemplate {
  id   String @id @default(uuid()) @db.NVarChar(36)
  name String @db.NVarChar(200)

  /// SMS | BALE | EMAIL — a template is written for a channel, because 70
  /// characters of Persian and an email body are not the same piece of writing.
  channel String @db.NVarChar(20)

  /// Email only; ignored by the other two.
  subject String? @db.NVarChar(400)
  body    String  @db.NVarChar(Max)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@index([channel])
  @@map("message_templates")
}

/// The outbox: every message this system has sent or means to send.
///
/// Manual sends and automated ones land in the same table on purpose — there is
/// then one place that answers "what have we sent this customer", which is the
/// question people actually ask.
model Message {
  id String @id @default(uuid()) @db.NVarChar(36)

  channel       String  @db.NVarChar(20)
  /// Phone number, Bale chat id or email address — whichever the channel needs.
  recipient     String  @db.NVarChar(400)
  recipientName String? @db.NVarChar(200)

  subject String? @db.NVarChar(400)
  body    String  @db.NVarChar(Max)

  /// QUEUED | SENT | FAILED | CANCELLED
  status String @db.NVarChar(20)

  /// When it may go. A message scheduled for later, or held out of quiet hours,
  /// simply has this in the future — there is no separate "held" state to get
  /// out of step with the clock.
  scheduledAt       DateTime
  scheduledAtJalali String?   @db.NVarChar(10)
  sentAt            DateTime?
  sentAtJalali      String?   @db.NVarChar(10)

  attempts          Int     @default(0)
  lastError         String? @db.NVarChar(Max)
  /// Whatever the provider called it, for chasing a message up with them.
  providerMessageId String? @db.NVarChar(200)

  /// True when the message was never really sent: the queue ran, the row was
  /// written, the provider was not called. For trying a new rule out safely.
  dryRun Boolean @default(false)

  /**
   * ----------------------------- provenance -----------------------------
   */

  customerId String?   @db.NVarChar(36)
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  projectId String?  @db.NVarChar(36)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  templateId String?          @db.NVarChar(36)
  template   MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  /// Which automation produced it, or null when a person sent it by hand.
  workflowRuleId   String? @db.NVarChar(60)
  workflowRuleName String? @db.NVarChar(200)

  /// The record the trigger was about, for a message that belongs to neither a
  /// customer nor a project — a purchase order, say.
  entityType String? @db.NVarChar(40)
  entityId   String? @db.NVarChar(36)

  createdByUserId String? @db.NVarChar(36)
  createdByName   String? @db.NVarChar(200)

  createdAt DateTime @default(now())

  @@index([status, scheduledAt])
  @@index([customerId])
  @@index([projectId])
  @@index([createdAt])
  @@map("messages")
}

/// The assistant's provider credentials.
///
/// Its own table rather than a field on the settings document, which is loaded
/// whole by every browser: a key there would be handed to every signed-in user.
/// One row, keyed by a fixed id, because there is one assistant.
model AssistantCredentials {
  id        String   @id @db.NVarChar(36)
  apiKey    String?  @db.NVarChar(500)
  updatedAt DateTime @default(now())

  @@map("assistant_credentials")
}

/// A write the assistant has prepared and nobody has yet approved.
///
/// The prepared payload is stored **here**, not handed to the browser and
/// posted back: the summary a person reads and the record that gets written
/// have to be the same object, and a payload that made a round trip through the
/// client is just an ordinary unreviewed write with a confirmation dialog in
/// front of it.
model AssistantAction {
  id     String @id @db.NVarChar(36)
  action String @db.NVarChar(60)
  /// Whose proposal it is. Only they may confirm it.
  userId String @db.NVarChar(36)
  /// pending | confirmed | cancelled | failed
  status String @db.NVarChar(20)

  title     String  @db.NVarChar(400)
  /// The summary lines shown on the confirmation card, as JSON.
  summary   String? @db.NVarChar(Max)
  /// What `execute` will be given, as JSON.
  payload   String? @db.NVarChar(Max)
  /// What the model asked for, as JSON — kept so a refusal can be explained.
  arguments String? @db.NVarChar(Max)

  resultId    String? @db.NVarChar(36)
  resultLabel String? @db.NVarChar(400)
  error       String? @db.NVarChar(Max)

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([userId, status])
  @@index([createdAt])
  @@map("assistant_actions")
}

/// A credential that lets a third party drive this API as one of its users.
///
/// Stored as a SHA-256 of the whole token rather than a bcrypt hash, and that
/// is deliberate: bcrypt's cost exists to slow a dictionary attack on a secret
/// a person chose, and this is 256 bits from the system's random source, which
/// no dictionary reaches. What SHA-256 buys instead is a unique index, so
/// authenticating a request is one index seek rather than a bcrypt comparison
/// against every row — on every call an integration makes.
model ApiToken {
  id   String @id @db.NVarChar(36)
  name String @db.NVarChar(200)
  /// The first characters of the token, in the clear, to recognise it in the list.
  prefix String @db.NVarChar(20)
  /// SHA-256 of the token, hex.
  tokenHash String @unique @db.NVarChar(64)

  /// Whose permissions this token carries.
  userId String @db.NVarChar(36)
  /// read | full
  scope String @db.NVarChar(10)

  isActive   Boolean   @default(true)
  expiresAt  DateTime?
  lastUsedAt DateTime?

  createdAt       DateTime @default(now())
  createdByUserId String?  @db.NVarChar(36)

  @@index([userId])
  @@map("api_tokens")
}
