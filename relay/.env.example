# The shared secret the ERP sends as `Authorization: Bearer <token>`.
# REQUIRED — the relay refuses to start without it, and refuses anything under
# 24 characters. Generate one with:  openssl rand -hex 32
# Put the SAME value in the ERP's WHATSAPP_RELAY_TOKEN.
RELAY_TOKEN=

# Port the relay listens on. The TLS proxy in front forwards to it.
# RELAY_PORT=8787

# Interface to bind. Loopback by default so the relay is unreachable from the
# internet and only the proxy can reach it. Change this only if something else
# is terminating TLS.
# RELAY_HOST=127.0.0.1
